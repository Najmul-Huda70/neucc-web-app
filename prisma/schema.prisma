generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId        String         @id
  name          String
  email         String         @unique
  password      String
  image         String?
  role          Role           @default(MEMBER)
  status        Status         @default(ACTIVE)

  // Forgot Password OTP Fields
  resetOtp           String?
  resetOtpExpiresAt  DateTime?
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  user_posts    userPost[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Post {
  postId      String     @id @default(uuid())
  postTitle   String
  status      Status     @default(ACTIVE)
  createdAt   DateTime   @default(now())
  committeeId String
  committee   Committee  @relation(fields: [committeeId], references: [committeeId], onDelete: Cascade)
  user_posts  userPost[]

  @@map("posts")
}

model userPost {
  postId      String
  post        Post      @relation(fields: [postId], references: [postId], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [committeeId], onDelete: Cascade)
  status      Status    @default(ACTIVE)
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@id([postId, userId]) // same post-এ many user
  @@unique([userId, committeeId]) // একজন user, একই committee-তে max ১টা post
  @@map("user_posts")
}

model Committee {
  committeeId String     @id @default(uuid())
  type        Type
  year        Int
  status      Status     @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       Post[]
  user_posts  userPost[]

  @@unique([type,year])
  @@map("committees")
}

enum Role {
  ADMIN
  MODERATOR
  MEMBER
}

enum Status {
  ACTIVE
  DEACTIVATED // সাময়িক নিষ্ক্রিয়, আবার active করা যাবে
  CLOSED // স্থায়ীভাবে বন্ধ, মেয়াদ শেষ
}

enum Type {
  EXECUTIVE
  ELECTION
}
