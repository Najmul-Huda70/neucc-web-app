generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId        String         @id
  name          String
  email         String         @unique
  password      String
  image         String?
  role          Role           @default(MEMBER)
  status        Status         @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  postId        String?
  refreshTokens RefreshToken[]
  post          Post?          @relation(fields: [postId], references: [postId])

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Post {
  postId      String    @id @default(uuid())
  postTitle   String
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now())
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  users       User[]

  @@map("posts")
}

model Committee {
  id        String   @id @default(uuid())
  type      Type
  session   String
  blockReason String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]

  @@map("committees")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MODARATOR
  MEMBER
}

enum Status {
  ACTIVE
  BLOCKED
}

enum Type {
  ADVISOR
  EXECUTIVE
  ELECTION
}
