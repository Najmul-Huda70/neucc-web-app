# Database
# Neon / Supabase connection strings. Use the pooled URL for DATABASE_URL and
# the direct connection string for DIRECT_URL when Prisma needs a non-pooled DB.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT
# Generate separate long random values for each environment.
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"