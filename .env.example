# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/neucc?schema=public"

# JWT (see src/lib/auth/jwt.ts)
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Public site URL — used to build absolute links (login links in emails,
# the Constitution PDF redirect, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Agentic AI Content Generator (Step 8) — src/lib/ai/notice-drafter.ts
ANTHROPIC_API_KEY="sk-ant-..."

# Email (Step 9) — src/lib/email/mailer.ts, via Nodemailer + SMTP.
# Any standard SMTP provider works (Gmail app password, SendGrid, Mailgun,
# Amazon SES, etc.) — this project talks plain SMTP, not a provider-specific
# API. Leaving these unset is fine: sendMail() degrades to a no-op that logs
# and returns { sent: false } rather than throwing (see Step 6's
# credential-email and Step 3's access-granted-email call sites for how
# callers already handle that).
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="NEUCC <no-reply@example.com>"

NODE_ENV="development"
